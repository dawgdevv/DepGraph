# Vercel (Next.js) — set in Vercel dashboard > Environment Variables
# When set, /api/analyses proxies to the VPS worker; else runs in-process (local dev)
WORKER_URL=https://worker.yourdomain.com
WORKER_TOKEN=change-me-same-as-vps
# WORKER_TOKEN is Bearer secret for VPS worker auth; leave empty to disable auth (dev only)

# CognoDB — server-only, never expose to client
COGNODB_URI=bolt+s://db-....bravo.databases.cognodb.com
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=...

# Optional — for local dev running worker inline you don't need WORKER_URL
# For VPS worker itself, see services/worker/.env.example
